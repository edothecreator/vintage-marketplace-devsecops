# =============================================================================
#  TEMPLATE DE CONFIGURATION — copier en .env et renseigner les valeurs
#
#  .env est ignore par git (voir .gitignore racine). NE JAMAIS y committer de
#  secret reel. Ce fichier .env.example ne contient QUE des valeurs factices.
#
#  Pratique : P30 Secrets management, ASVS 13.3.1
# =============================================================================

# --- Environnement ---
NODE_ENV=development
PORT=3000

# --- Base de donnees (correspond a docker-compose.yml) ---
DATABASE_URL="postgresql://marketplace:marketplace_dev_pw@localhost:5432/marketplace?schema=public"

# --- Cle de signature des jetons (ASVS 9.1.2) ---
# En developpement : une valeur longue et aleatoire suffit.
# En CI/production : injectee depuis le coffre de secrets, jamais ici.
# Generer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=remplacer_par_une_valeur_aleatoire_longue_en_local

# --- Duree de vie des jetons (ADR 0006) ---
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
SESSION_ABSOLUTE_TTL=30d

# --- Cle API Gemini (Phase 8 — non requise avant) ---
# En local : coller la cle ici. En CI : secret GitHub GEMINI_API_KEY.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Plafonds IA (ADR 0006, controle LLM10) ---
AI_DAILY_LIMIT_PER_USER=20
AI_DAILY_LIMIT_GLOBAL=200

# --- Stockage des fichiers ---
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_BYTES=5242880

# --- CORS (ASVS 3.4.2) — origines autorisees, separees par des virgules ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
